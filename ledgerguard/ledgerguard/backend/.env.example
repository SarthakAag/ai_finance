DATABASE_URL=postgresql+psycopg2://ledgerguard:ledgerguard@localhost:5433/ledgerguard

# LLM provider: "ollama" or "claude" (fallback)
LLM_PROVIDER=ollama

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_EMBED_MODEL=nomic-embed-text

# Only needed if LLM_PROVIDER=claude
ANTHROPIC_API_KEY=

# Matching engine tolerances
MDR_TOLERANCE_PCT=0.05
FX_TOLERANCE_PCT=0.02
